rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    
    function isValidUserProfile(data) {
        return data.username is string && data.username.size() >= 3 &&
               (!('bio' in data) || data.bio is string) &&
               (!('profileImageUrl' in data) || data.profileImageUrl is string);
    }

    function isValidUserActivity(data) {
        return data.userId is string && data.activityType is string && data.pointsEarned is number && data.timestamp is timestamp;
    }
    function isValidReward(data) {
        return data.name is string && data.cost is number && (!('description' in data) || data.description is string) && (!('imageUrl' in data) || data.imageUrl is string);
    }
    function isValidUserReward(data) {
        return data.rewardId is string && data.timestamp is timestamp;
    }
    function isValidFriendship(data) {
        return data.users is list && data.status is string && data.createdAt is timestamp;
    }
    function isValidChat(data) {
        return data.members is list && data.updatedAt is timestamp;
    }
    function isValidMessage(data) {
        return data.senderId is string && data.text is string && data.timestamp is timestamp;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && isValidUserProfile(request.resource.data);
      
      match /activities/{activityId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidUserActivity(request.resource.data);
      }
      
      match /rewards/{rewardId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidUserReward(request.resource.data);
      }

      match /journals/{journalId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }
    match /leaderboard/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /rewards/{rewardId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /friendships/{friendshipId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.users;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.users;
      allow update: if isSignedIn() && request.auth.uid in resource.data.users;
    }
    match /chats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.members;
      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members && isValidMessage(request.resource.data);
      }
    }
    match /spotlight/{spotlightId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
